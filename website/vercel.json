{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/updates/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/download/mac",
      "destination": "/api/download"
    },
    {
      "source": "/registry/:path*",
      "destination": "/api/registry?__path=:path*"
    }
  ],
  "functions": {
    "api/registry.js": {
      "maxDuration": 15
    },
    "api/download.js": {
      "maxDuration": 15
    },
    "api/permagent-analytics/collect.js": {
      "maxDuration": 10
    },
    "api/permagent-analytics/drain.js": {
      "maxDuration": 30
    },
    "api/feedback.js": {
      "maxDuration": 15
    },
    "api/ideas.js": {
      "maxDuration": 15
    }
  },
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/updates/arm64/Intoponet-0.1.20-arm64-mac.zip",
      "destination": "https://klszmlqipgkquywh.public.blob.vercel-storage.com/releases/0.1.20/Intoponet-0.1.20-arm64-mac.zip",
      "permanent": false
    }
  ]
}
