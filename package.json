{
  "name": "intoponet",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "description": "A privacy-first spatial browser for exploring the living web.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "node scripts/launch-desktop.cjs",
    "start": "node scripts/launch-desktop.cjs",
    "preview": "node scripts/launch-desktop.cjs preview",
    "build": "npm run build --workspace @intoponet/desktop",
    "package:macos:preview": "node scripts/package-macos.cjs preview",
    "package:macos:release": "node scripts/package-macos.cjs release",
    "benchmark:electron": "electron experiments/electron-compositor/main.cjs",
    "dag": "node scripts/dag.cjs",
    "build:laya-sandbox": "node experiments/laya-sandbox/run.mjs --build-only",
    "verify:laya-sandbox": "node experiments/laya-sandbox/run.mjs",
    "verify:laya-privacy": "node --experimental-strip-types experiments/laya-privacy-verification/verify.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test experiments/e2e/olds-gold.test.mjs website/api/_registry-proxy.test.mjs website/api/_download-notify.test.mjs",
    "verify:features": "node scripts/verify-features.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12"
  }
}
