{
  "name": "@intoponet/public-snapshots",
  "version": "0.1.0",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts src/publish.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --out-extension:.js=.mjs",
    "start": "npm run build && node dist/server.mjs",
    "publish": "npm run build && node dist/publish.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "@intoponet/field-snapshot": "0.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
